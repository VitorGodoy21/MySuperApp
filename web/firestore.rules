rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isQrOwner(qrId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/qrcodes/$(qrId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSelf(userId);
    }

    match /qrcodes/{qrId} {
      // Leitura pública de um QR Code específico
      allow get: if true;

      // O app manager lista os QR Codes do usuário autenticado com whereEqualTo("userId", uid)
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // O dono autenticado pode atualizar o próprio QR Code, mas não trocar o userId
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;

      // O usuário autenticado pode criar QR Codes próprios com os campos esperados
      // (o campo id é @DocumentId no app e não é gravado no documento)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.identifier is string
        && request.resource.data.identifier.size() > 0
        && request.resource.data.type is string
        && request.resource.data.staticUrl is string
        && request.resource.data.redirectUrl is string
        && request.resource.data.text is string;

      // O dono autenticado pode excluir o próprio QR Code
      // (subcoleções comments/access_logs não são apagadas automaticamente)
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Comentários: leitura pública; moderação/edição permitida ao dono do QR autenticado
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isQrOwner(qrId);
      }

      // Access logs: leitura e exclusão apenas para o dono do QR; escrita segue fora do cliente
      match /access_logs/{logId} {
        allow read: if isQrOwner(qrId);
        allow delete: if isQrOwner(qrId);
        allow create, update: if false;
      }
    }

    // Rate limiting interno — acessado apenas via Admin SDK (Cloud Function)
    match /_rate_limits/{doc} {
      allow read, write: if false;
    }

    // Módulo financeiro (feature-financial): dados sem userId, acesso restrito a usuários autenticados
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.amount is number
        && request.resource.data.paymentMethod is string
        && request.resource.data.isRecurring is bool
        && request.resource.data.transactionType in ['EXPENSE', 'INCOME'];
      // Ajustes pelo app:
      //  - título e valor (ex.: valor real do salário)
      //  - category: apenas remoção de ids (exclusão de categoria via arrayRemove)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'amount', 'category'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'amount'])
          || (request.resource.data.amount is number && request.resource.data.title is string)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['category'])
          || (
            request.resource.data.category is list
            && resource.data.category is list
            && request.resource.data.category.size() <= resource.data.category.size()
          )
        );
      allow delete: if isAuthenticated();
    }

    match /cards/{cardId} {
      allow read: if isAuthenticated();
      // Cadastro de cartão pelo app
      allow create: if isAuthenticated()
        && request.resource.data.bank is string
        && request.resource.data.paymentMethods is list
        && request.resource.data.allowsDeposit is bool
        && request.resource.data.closingDay is number
        && request.resource.data.invoiceDueDate is number;
      // Edição de cartão pelo app: somente campos de configuração
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bank', 'paymentMethods', 'finalCode', 'closingDay', 'invoiceDueDate'])
        && request.resource.data.bank is string
        && request.resource.data.paymentMethods is list
        && request.resource.data.finalCode is string
        && request.resource.data.closingDay is number
        && request.resource.data.invoiceDueDate is number;
      allow delete: if false;
    }

    // Categorias de transação gerenciadas pelo app (tela "Categorias")
    // transactionType: 'EXPENSE' (despesa) | 'INCOME' (receita)
    match /transactions_category/{categoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.transactionType in ['EXPENSE', 'INCOME'];
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'transactionType'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.transactionType in ['EXPENSE', 'INCOME'];
      // A exclusão remove antes o id da categoria do campo `category` das transações (app)
      allow delete: if isAuthenticated();
    }

    // Política definitiva: qualquer caminho não tratado explicitamente fica negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
