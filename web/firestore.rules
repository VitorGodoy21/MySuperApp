rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isQrOwner(qrId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/qrcodes/$(qrId)).data.userId == request.auth.uid;
    }

    // Dono do documento existente (financeiro/academia): campo userId gravado pelo app
    function isOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Documento novo pertence ao usuário autenticado
    function createsOwn() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Flags do painel web (users/{uid}.featureFlags): map só com booleanos; ausente = tudo habilitado
    function validFeatureFlags(data) {
      return !('featureFlags' in data)
        || (data.featureFlags is map
          && data.featureFlags.keys().hasOnly(['finance', 'smartTags', 'qrCode', 'nfc', 'workout', 'diet', 'recipes'])
          && (!('finance' in data.featureFlags) || data.featureFlags.finance is bool)
          && (!('smartTags' in data.featureFlags) || data.featureFlags.smartTags is bool)
          && (!('qrCode' in data.featureFlags) || data.featureFlags.qrCode is bool)
          && (!('nfc' in data.featureFlags) || data.featureFlags.nfc is bool)
          && (!('workout' in data.featureFlags) || data.featureFlags.workout is bool)
          && (!('diet' in data.featureFlags) || data.featureFlags.diet is bool)
          && (!('recipes' in data.featureFlags) || data.featureFlags.recipes is bool));
    }

    // Smart Tag SPOTIFY (qrcodes.type == 'SPOTIFY'): alvo (playlist/música) e dispositivo
    // Spotify Connect escolhidos no app. Todos opcionais; tokens nunca passam pelo cliente.
    function validSpotifyFields(data) {
      return (!('spotifyUri' in data) || (data.spotifyUri is string && data.spotifyUri.size() <= 120))
        && (!('spotifyName' in data) || (data.spotifyName is string && data.spotifyName.size() <= 300))
        && (!('spotifySubtitle' in data) || (data.spotifySubtitle is string && data.spotifySubtitle.size() <= 300))
        && (!('spotifyImageUrl' in data) || (data.spotifyImageUrl is string && data.spotifyImageUrl.size() <= 1000))
        && (!('spotifyDeviceId' in data) || (data.spotifyDeviceId is string && data.spotifyDeviceId.size() <= 120))
        && (!('spotifyDeviceName' in data) || (data.spotifyDeviceName is string && data.spotifyDeviceName.size() <= 200))
        && (!('spotifyShuffle' in data) || data.spotifyShuffle is bool);
    }

    function validRecipe(data, recipeId) {
      return recipeId.matches('[A-Za-z0-9_-]+')
        && data.keys().hasAll(['userId', 'name', 'description', 'ingredients', 'steps',
          'prepMinutes', 'cookMinutes', 'yield', 'category', 'difficulty', 'notes',
          'isFavorite', 'imagePath', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'name', 'description', 'ingredients', 'steps',
          'prepMinutes', 'cookMinutes', 'yield', 'category', 'difficulty', 'notes',
          'isFavorite', 'imagePath', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.description is string && data.description.size() <= 4000
        && data.notes is string && data.notes.size() <= 4000
        && data.yield is string && data.yield.size() <= 200
        && data.ingredients is list && data.ingredients.size() > 0 && data.ingredients.size() <= 100
        && data.steps is list && data.steps.size() > 0 && data.steps.size() <= 100
        && (data.prepMinutes == null || (data.prepMinutes is int && data.prepMinutes >= 0 && data.prepMinutes <= 999999))
        && (data.cookMinutes == null || (data.cookMinutes is int && data.cookMinutes >= 0 && data.cookMinutes <= 999999))
        && (data.category == null || data.category in ['STARTER', 'MAIN', 'SIDE', 'SNACK', 'DESSERT', 'DRINK'])
        && (data.difficulty == null || data.difficulty in ['EASY', 'MEDIUM', 'HARD'])
        && data.isFavorite is bool
        && (data.imagePath == null || (data.imagePath is string
          && data.imagePath.matches('recipe_images/' + request.auth.uid + '/' + recipeId + '/[^/]+[.]jpg')))
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    match /recipes/{recipeId} {
      // Saving a new, client-reserved id uses a transaction that first reads its absence.
      allow get: if isAuthenticated()
        && (!exists(/databases/$(database)/documents/recipes/$(recipeId)) || isOwner());
      allow list: if isOwner();
      allow create: if createsOwn() && validRecipe(request.resource.data, recipeId)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && validRecipe(request.resource.data, recipeId);
      allow delete: if isOwner();
    }

    match /users/{userId} {
      allow read, delete: if isSelf(userId);
      allow create, update: if isSelf(userId) && validFeatureFlags(request.resource.data);
    }

    match /qrcodes/{qrId} {
      // Leitura pública de um QR Code específico
      allow get: if true;

      // O app manager lista os QR Codes do usuário autenticado com whereEqualTo("userId", uid)
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // O dono autenticado pode atualizar o próprio QR Code, mas não trocar o userId
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && validSpotifyFields(request.resource.data);

      // O usuário autenticado pode criar QR Codes próprios com os campos esperados
      // (o campo id é @DocumentId no app e não é gravado no documento)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.identifier is string
        && request.resource.data.identifier.size() > 0
        && request.resource.data.type is string
        && request.resource.data.staticUrl is string
        && request.resource.data.redirectUrl is string
        && request.resource.data.text is string
        && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
        && (!('imagePath' in request.resource.data) || request.resource.data.imagePath is string)
        && validSpotifyFields(request.resource.data);

      // O dono autenticado pode excluir o próprio QR Code
      // (subcoleções comments/access_logs não são apagadas automaticamente)
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;

      // Comentários: leitura pública; moderação/edição permitida ao dono do QR autenticado
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isQrOwner(qrId);
      }

      // Access logs: leitura e exclusão apenas para o dono do QR; escrita segue fora do cliente
      match /access_logs/{logId} {
        allow read: if isQrOwner(qrId);
        allow delete: if isQrOwner(qrId);
        allow create, update: if false;
      }
    }

    // Rate limiting interno — acessado apenas via Admin SDK (Cloud Function)
    match /_rate_limits/{doc} {
      allow read, write: if false;
    }

    // Integração Spotify (Smart Tag SPOTIFY): tokens OAuth e states de autorização
    // ficam exclusivamente no backend (Cloud Functions, Admin SDK).
    match /spotify_tokens/{userId} {
      allow read, write: if false;
    }

    match /spotify_auth_states/{stateId} {
      allow read, write: if false;
    }

    // Módulo financeiro (feature-financial): cada documento tem userId (dono);
    // o app lista com whereEqualTo("userId", uid). userId é imutável (não está nas affectedKeys permitidas).
    match /transactions/{transactionId} {
      allow read: if isOwner();
      // Pagamentos de fatura são transações EXPENSE com paymentMethod == 'INVOICE_PAYMENT',
      // cardId e invoicePaymentMonth (yyyy-MM da fatura quitada); passam pelas mesmas regras.
      allow create: if createsOwn()
        && request.resource.data.amount is number
        && request.resource.data.paymentMethod is string
        && request.resource.data.isRecurring is bool
        && request.resource.data.transactionType in ['EXPENSE', 'INCOME'];
      // Ajustes pelo app:
      //  - título, valor e categorias (lista de ids; exclusão de categoria usa arrayRemove)
      //  - recorrência: recurrenceEnd (encerrar), excludedMonths (só cresce, via arrayUnion)
      //    e overrides (ajustes por mês {yyyy-MM: {amount, title}})
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['title', 'amount', 'category', 'recurrenceEnd', 'excludedMonths', 'overrides']
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['title', 'amount'])
          || (request.resource.data.amount is number && request.resource.data.title is string)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['category'])
          || request.resource.data.category is list
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['recurrenceEnd', 'excludedMonths', 'overrides']
          )
          || resource.data.isRecurring == true
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['recurrenceEnd'])
          || request.resource.data.recurrenceEnd is string
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['excludedMonths'])
          || request.resource.data.excludedMonths is list
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['overrides'])
          || request.resource.data.overrides is map
        );
      allow delete: if isOwner();
    }

    match /cards/{cardId} {
      allow read: if isOwner();
      // Cadastro de cartão pelo app
      allow create: if createsOwn()
        && request.resource.data.bank is string
        && request.resource.data.paymentMethods is list
        && request.resource.data.allowsDeposit is bool
        && request.resource.data.closingDay is number
        && request.resource.data.invoiceDueDate is number;
      // Edição de cartão pelo app: somente campos de configuração
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['bank', 'paymentMethods', 'finalCode', 'closingDay', 'invoiceDueDate'])
        && request.resource.data.bank is string
        && request.resource.data.paymentMethods is list
        && request.resource.data.finalCode is string
        && request.resource.data.closingDay is number
        && request.resource.data.invoiceDueDate is number;
      allow delete: if false;
    }

    // Categorias de transação gerenciadas pelo app (tela "Categorias")
    // transactionType: 'EXPENSE' (despesa) | 'INCOME' (receita)
    match /transactions_category/{categoryId} {
      allow read: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.transactionType in ['EXPENSE', 'INCOME'];
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'description', 'transactionType'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.transactionType in ['EXPENSE', 'INCOME'];
      // A exclusão remove antes o id da categoria do campo `category` das transações (app)
      allow delete: if isOwner();
    }

    // Dieta diária privada: um documento por usuário.
    match /diets/{userId} {
      allow get, delete: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['meals', 'notes', 'updatedAt'])
        && request.resource.data.meals is list
        && request.resource.data.notes is string
        && request.resource.data.updatedAt is timestamp;
    }

    // ===== Academia (feature-workout) — cada documento tem userId (dono), igual ao financeiro =====

    // Histórico de pesagens (um documento por registro)
    match /body_measurements/{measurementId} {
      allow read: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.heightCm is number
        && request.resource.data.heightCm > 0
        && request.resource.data.measuredAt is timestamp
        && request.resource.data.notes is string;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['weightKg', 'heightCm', 'measuredAt', 'notes'])
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.heightCm is number
        && request.resource.data.heightCm > 0
        && request.resource.data.measuredAt is timestamp
        && request.resource.data.notes is string;
      allow delete: if isOwner();
    }

    // Exercícios reutilizáveis nos treinos (catálogo por usuário)
    match /exercises/{exerciseId} {
      allow read: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.muscleGroup is string
        && request.resource.data.description is string
        && request.resource.data.notes is string
        && request.resource.data.videoUrl is string;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'muscleGroup', 'description', 'notes', 'videoUrl'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.muscleGroup is string
        && request.resource.data.description is string
        && request.resource.data.notes is string
        && request.resource.data.videoUrl is string;
      // O app bloqueia a exclusão quando o exercício está em algum treino (workouts.exerciseIds)
      allow delete: if isOwner();
    }

    // Treinos: `items` é a lista ordenada de exercícios; `exerciseIds` é derivado de `items`
    match /workouts/{workoutId} {
      allow read: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.items is list
        && request.resource.data.exerciseIds is list
        && request.resource.data.notes is string
        && (!('isOther' in request.resource.data) || request.resource.data.isOther is bool);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'dayOfWeek', 'items', 'exerciseIds', 'notes', 'icon', 'isOther', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.items is list
        && request.resource.data.exerciseIds is list
        && request.resource.data.notes is string
        && (!('isOther' in request.resource.data) || request.resource.data.isOther is bool);
      allow delete: if isOwner();
    }

    // Registro de treinos realizados (data, tempo na academia, calorias)
    match /workout_sessions/{sessionId} {
      allow read: if isOwner();
      allow create: if createsOwn()
        && request.resource.data.workoutId is string
        && request.resource.data.workoutId.size() > 0
        && request.resource.data.date is timestamp
        && (request.resource.data.durationMinutes == null
            || (request.resource.data.durationMinutes is int
                && request.resource.data.durationMinutes > 0))
        && (request.resource.data.calories == null
            || (request.resource.data.calories is int
                && request.resource.data.calories > 0));
      allow update: if false;
      allow delete: if isOwner();
    }

    // Política definitiva: qualquer caminho não tratado explicitamente fica negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
